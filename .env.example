# Sibyl Memory
ITERUM_MEMORY_BACKEND=local        # switch to: sibyl
ITERUM_LOCAL_MEMORY_DIR=.iterum-memory

# Base. Confirm mainnet vs testnet with the organisers before filling these in.
BASE_RPC_URL=
BASE_CHAIN_ID=
AGENT_PRIVATE_KEY=                 # never commit the real value

# Iterum's own Sibyl DB, separate from your personal ~/.sibyl-memory/memory.db
ITERUM_SIBYL_DB=./.iterum-memory/iterum.db
